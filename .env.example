# 麦当劳 MCP Token（申请入口：https://open.mcd.cn/mcp）
# 复制本文件为 .env 并填入真实值；.env 已在 .gitignore 中排除，切勿提交
MCP_TOKEN=your_mcp_token_here

# 可选：覆盖 MCP 端点（默认 https://mcp.mcd.cn）
# MCP_URL=https://mcp.mcd.cn

# Demo 参数
DEMO_CITY=广州
DEMO_STORE_ID=
DEMO_BUDGET=20
DEMO_HEADCOUNT=2
DEMO_NO_SPICY=0

# 下单开关：1 = 真实下单（默认 0，仅演示）
AUTO_ORDER=0
# 履约方式：pickup 自取 / delivery 麦乐送
ORDER_TYPE=pickup
